{
  "name": "aivplayer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "out/main/index.js",
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^6.2.4",
    "@types/node": "^22.20.3",
    "@types/ws": "^8.18.1",
    "electron": "^44.4.1",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^5.9.3",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "music-metadata": "^11.15.0",
    "ws": "^8.21.3"
  },
  "description": "Two-PC FLAC player recreating Eno's Ambient 4: On Land three-speaker difference arrangement",
  "author": "Matt Wright",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "preview": "electron-vite preview",
    "test": "vitest run",
    "check": "tsc --noEmit -p tsconfig.json && svelte-check --tsconfig ./tsconfig.json",
    "dist:win": "electron-vite build && electron-builder --win zip"
  }
}
